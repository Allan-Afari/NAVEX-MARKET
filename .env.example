# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Google Analytics (optional)
# VITE_GA_MEASUREMENT_ID=your-ga-measurement-id

# Lovable Auth Configuration (optional)
# VITE_LOVABLE_API_KEY=your-lovable-api-key

# Production monitoring
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Email service
# RESEND_API_KEY=your-resend-api-key
# APP_URL=https://app.example.com

# Smile ID webhook signature secret
# SMILE_API_KEY=your-smile-api-key

# Offline mode for development/testing only
# VITE_ENABLE_OFFLINE_MODE=true

# Server-only secrets (do not expose in client builds)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Environment
VITE_ENV=development
